{
  "name": "@astrona-io/perses-plugin-treemap",
  "version": "0.1.0",
  "scripts": {
    "dev": "rsbuild dev",
    "build": "npm run build-mf && concurrently \"npm:build:*\"",
    "build-mf": "rsbuild build",
    "build:esm": "swc ./src -d dist/lib --strip-leading-paths --config-file .swcrc --copy-files",
    "build:types": "tsc --project tsconfig.build.json",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "cross-env LC_ALL=C TZ=UTC jest --passWithNoTests",
    "type-check": "tsc --noEmit"
  },
  "type": "module",
  "main": "lib/index.js",
  "module": "lib/index.js",
  "types": "lib/index.d.ts",
  "devDependencies": {
    "@module-federation/rsbuild-plugin": "^2.9.1",
    "@rsbuild/core": "^1.7.6",
    "@rsbuild/plugin-react": "^1.4.6",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.15.43",
    "@swc/jest": "^0.2.39",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.13.3",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "^3.3.3",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-router-dom": "^6.30.6",
    "typescript": "~5.9.3"
  },
  "peerDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@hookform/resolvers": "^5.9.1",
    "@mui/material": "^6.1.10",
    "@perses-dev/client": "0.55.1",
    "@perses-dev/components": "0.55.1",
    "@perses-dev/dashboards": "0.55.1",
    "@perses-dev/explore": "0.55.1",
    "@perses-dev/plugin-system": "0.55.1",
    "@perses-dev/spec": "0.3.0",
    "@tanstack/react-query": "^4.39.1",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "echarts": "5.6.0",
    "immer": "^10.1.1",
    "lodash": "^4.17.21",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-hook-form": "^7.87.0",
    "use-resize-observer": "^9.0.0"
  },
  "files": [
    "lib/**/*",
    "__mf/**/*",
    "mf-manifest.json",
    "mf-stats.json"
  ],
  "perses": {
    "metadata": {
      "name": "Treemap",
      "registry": "astrona-io"
    },
    "schemasPath": "schemas",
    "plugins": [
      {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Treemap"
          },
          "name": "TreemapChart"
        }
      }
    ]
  },
  "description": "Perses panel plugin: treemap of a cost or resource breakdown (team, namespace, workload) over a time-series query, with drill-down, top-N grouping and share of parent and total",
  "license": "Apache-2.0",
  "author": "Astrona",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/astrona-io/perses-plugin-treemap.git"
  },
  "homepage": "https://github.com/astrona-io/perses-plugin-treemap#readme",
  "bugs": {
    "url": "https://github.com/astrona-io/perses-plugin-treemap/issues"
  },
  "keywords": [
    "perses",
    "plugin",
    "treemap",
    "finops",
    "cost",
    "opencost",
    "prometheus"
  ]
}
